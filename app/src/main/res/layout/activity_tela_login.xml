<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_primary_solid"
            android:padding="16dp"
            android:src="@drawable/ic_scale"
            android:tint="@color/surface"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Title"
            android:text="ADVR Jurídico"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Body"
            android:text="Sua justiça simplificada na palma da mão"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Label"
            android:text="E-mail cadastrado"
            android:labelFor="@+id/campo_email" />

        <EditText
            android:id="@+id/campo_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Field"
            android:hint="seu.email@exemplo.com"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:drawableStart="@drawable/ic_user"
            android:drawablePadding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Label"
            android:text="Senha"
            android:labelFor="@+id/campo_senha" />

        <EditText
            android:id="@+id/campo_senha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Field"
            android:hint="Digite sua senha"
            android:inputType="textPassword"
            android:singleLine="true"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="10dp" />

        <Button
            android:id="@+id/botao_alternar_senha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/LinkButton"
            android:text="Mostrar senha"
            android:layout_gravity="end" />

        <Button
            android:id="@+id/botao_entrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/PrimaryButton"
            android:text="Entrar na conta"
            android:drawableEnd="@drawable/ic_arrow"
            android:drawableTint="@color/surface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Body"
            android:text="Ainda não tem uma conta?"
            android:gravity="center"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/botao_cadastrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/LinkButton"
            android:text="Criar nova conta" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            style="@style/Card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Label"
                android:text="Outras formas de acesso" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Body"
                android:text="Login com Google e Facebook ainda não disponível nesta versão." />

            <Button
                android:id="@+id/botao_google"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/SecondaryButton"
                android:text="Google • saiba mais" />

            <Button
                android:id="@+id/botao_facebook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/SecondaryButton"
                android:text="Facebook • saiba mais" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Body"
            android:text="Acesso ao seu painel jurídico"
            android:gravity="center"
            android:layout_marginTop="10dp" />

        <ProgressBar
            android:id="@+id/barra_progresso"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/texto_mensagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Body"
            android:text=""
            android:textColor="@color/danger"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
