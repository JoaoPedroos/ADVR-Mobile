<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/botao_voltar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/LinkButton"
            android:text="Voltar ao login"
            android:drawableStart="@drawable/ic_back" />

        <TextView
            android:id="@+id/texto_titulo_cadastro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Title"
            android:text="Criar novo usuário" />

        <TextView
            android:id="@+id/texto_descricao_cadastro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Body"
            android:text="Cadastre-se para acessar o ADVR Jurídico." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            style="@style/Card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Label"
                android:text="Nome completo"
                android:labelFor="@+id/campo_nome" />

            <EditText
                android:id="@+id/campo_nome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Field"
                android:hint="Ex.: João Pedro"
                android:inputType="textPersonName"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Label"
                android:text="E-mail"
                android:labelFor="@+id/campo_email" />

            <EditText
                android:id="@+id/campo_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Field"
                android:hint="seu.email@exemplo.com"
                android:inputType="textEmailAddress"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Label"
                android:text="CPF"
                android:labelFor="@+id/campo_cpf" />

            <EditText
                android:id="@+id/campo_cpf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Field"
                android:hint="11 dígitos"
                android:inputType="number"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Label"
                android:text="Senha"
                android:labelFor="@+id/campo_senha" />

            <EditText
                android:id="@+id/campo_senha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Field"
                android:hint="Mínimo de 8 caracteres"
                android:inputType="textPassword"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Label"
                android:text="Confirmar senha"
                android:labelFor="@+id/campo_confirmar_senha" />

            <EditText
                android:id="@+id/campo_confirmar_senha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Field"
                android:hint="Repita sua senha"
                android:inputType="textPassword"
                android:singleLine="true" />

            <Button
                android:id="@+id/botao_salvar_cadastro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/PrimaryButton"
                android:text="Criar minha conta" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/barra_progresso"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/texto_mensagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Body"
            android:text=""
            android:textColor="@color/danger"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
