<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/canvas">

    <include layout="@layout/include_cabecalho" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Title"
                android:text="Gestão administrativa" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Body"
                android:text="Gerencie os usuários, os processos e seus vínculos." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                style="@style/Card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Section"
                    android:text="Usuários e permissões" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Label"
                    android:text="Buscar por nome ou CPF"
                    android:labelFor="@+id/campo_busca_usuario" />

                <EditText
                    android:id="@+id/campo_busca_usuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Field"
                    android:hint="Buscar por nome ou CPF"
                    android:inputType="text"
                    android:singleLine="true"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="10dp" />

                <Button
                    android:id="@+id/botao_buscar_usuarios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/SecondaryButton"
                    android:text="Buscar usuários" />

                <LinearLayout
                    android:id="@+id/container_cards_usuarios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Label"
                    android:text="Usuário selecionado" />

                <Spinner
                    android:id="@+id/seletor_usuarios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:background="@drawable/bg_field_idle"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Label"
                    android:text="Novo perfil de acesso" />

                <Spinner
                    android:id="@+id/seletor_perfis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:background="@drawable/bg_field_idle"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/botao_salvar_perfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/PrimaryButton"
                    android:text="Atualizar perfil" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                style="@style/Card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Section"
                    android:text="Processos e vínculos" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Label"
                    android:text="Selecionar processo" />

                <Spinner
                    android:id="@+id/seletor_processos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:background="@drawable/bg_field_idle"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/botao_carregar_processo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/SecondaryButton"
                    android:text="Carregar processo" />

                <Button
                    android:id="@+id/botao_novo_processo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/LinkButton"
                    android:text="Novo processo / limpar formulário" />

                <TextView
                    android:id="@+id/texto_status_edicao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Badge"
                    android:text="Novo processo" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Section"
                    android:text="Dados do processo"
                    android:layout_marginTop="20dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Label"
                    android:text="Número do processo"
                    android:labelFor="@+id/campo_numero_processo" />

                <EditText
                    android:id="@+id/campo_numero_processo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Field"
                    android:hint="Número do processo"
                    android:inputType="text"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Label"
                    android:text="Assunto / título"
                    android:labelFor="@+id/campo_titulo_processo" />

                <EditText
                    android:id="@+id/campo_titulo_processo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Field"
                    android:hint="Assunto / título"
                    android:inputType="text"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Label"
                    android:text="Descrição"
                    android:labelFor="@+id/campo_descricao_processo" />

                <EditText
                    android:id="@+id/campo_descricao_processo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Field"
                    android:hint="Descrição"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:gravity="top" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Label"
                    android:text="Situação"
                    android:labelFor="@+id/campo_situacao_processo" />

                <EditText
                    android:id="@+id/campo_situacao_processo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Field"
                    android:hint="Situação"
                    android:inputType="text"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Label"
                    android:text="CPF do cliente para vincular"
                    android:labelFor="@+id/campo_cpf_cliente" />

                <EditText
                    android:id="@+id/campo_cpf_cliente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Field"
                    android:hint="11 dígitos"
                    android:inputType="number"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Body"
                    android:text="Ao editar, deixe o CPF vazio para manter os clientes atuais. Um novo CPF adiciona outro vínculo." />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Label"
                    android:text="Advogado responsável" />

                <Spinner
                    android:id="@+id/seletor_advogados"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:background="@drawable/bg_field_idle"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/botao_salvar_processo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/PrimaryButton"
                    android:text="Salvar processo e vínculo" />

                <Button
                    android:id="@+id/botao_remover_cliente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/DangerButton"
                    android:text="Remover vínculo de cliente" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                style="@style/Card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Section"
                    android:text="Importação e histórico" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Body"
                    android:text="Importe processos por JSON e consulte o registro das alterações." />

                <Button
                    android:id="@+id/botao_importar_json"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/SecondaryButton"
                    android:text="Importar arquivo JSON" />

                <Button
                    android:id="@+id/botao_historico_auditoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/SecondaryButton"
                    android:text="Ver histórico de alterações" />
            </LinearLayout>

            <Button
                android:id="@+id/botao_voltar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/LinkButton"
                android:text="Voltar ao início" />

            <ProgressBar
                android:id="@+id/barra_progresso"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/texto_mensagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Body"
                android:text=""
                android:textColor="@color/danger"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/include_navegacao" />
</LinearLayout>
