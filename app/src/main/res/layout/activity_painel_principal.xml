<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/canvas">

    <include layout="@layout/include_cabecalho" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:id="@+id/painel_inicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/cartao_boas_vindas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_hero_client"
                    android:padding="22dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:id="@+id/texto_perfil_painel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Badge"
                        android:text="Cliente"
                        android:textColor="@color/surface"
                        android:background="#22FFFFFF"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/texto_boas_vindas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Title"
                        android:text="Bem-vindo"
                        android:textColor="@color/surface" />

                    <TextView
                        android:id="@+id/texto_subtitulo_painel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Body"
                        android:text="Acompanhe suas informações e seus processos."
                        android:textColor="#DBEAFE"
                        android:layout_marginBottom="0dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Card"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Label"
                            android:text="Processos" />

                        <TextView
                            android:id="@+id/indicador_total_processos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Title"
                            android:text="0"
                            android:textColor="@color/primary"
                            android:layout_marginBottom="0dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Card"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Label"
                            android:text="Com responsável" />

                        <TextView
                            android:id="@+id/indicador_processos_atribuidos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Title"
                            android:text="0"
                            android:textColor="@color/primary"
                            android:layout_marginBottom="0dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/bloco_metricas_admin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Card"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Label"
                            android:text="Usuários" />

                        <TextView
                            android:id="@+id/indicador_total_usuarios"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Title"
                            android:text="0"
                            android:textColor="@color/primary"
                            android:layout_marginBottom="0dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Card"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Label"
                            android:text="Advogados" />

                        <TextView
                            android:id="@+id/indicador_total_advogados"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Title"
                            android:text="0"
                            android:textColor="@color/primary"
                            android:layout_marginBottom="0dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    style="@style/Card">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Section"
                        android:text="Seu acompanhamento jurídico" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Body"
                        android:text="Consulte os processos vinculados à sua conta, veja o responsável e mantenha seus dados atualizados." />

                    <Button
                        android:id="@+id/botao_abrir_processos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PrimaryButton"
                        android:text="Ver meus processos"
                        android:drawableEnd="@drawable/ic_arrow"
                        android:drawableTint="@color/surface" />

                    <Button
                        android:id="@+id/botao_abrir_perfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/SecondaryButton"
                        android:text="Meu perfil" />

                    <Button
                        android:id="@+id/botao_abrir_gestao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/SecondaryButton"
                        android:text="Abrir gestão administrativa"
                        android:visibility="gone" />
                </LinearLayout>
                
            </LinearLayout>

            <LinearLayout
                android:id="@+id/painel_processos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/titulo_lista_processos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Title"
                    android:text="Meus processos" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Body"
                    android:text="Informações dos processos vinculados à sua conta." />

                <Button
                    android:id="@+id/botao_atualizar_processos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/SecondaryButton"
                    android:text="Atualizar lista" />

                <LinearLayout
                    android:id="@+id/container_lista_processos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/barra_progresso"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/texto_mensagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Body"
                android:text=""
                android:textColor="@color/danger"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/include_navegacao" />
</LinearLayout>
