<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    style="@style/Card"
    android:background="@drawable/bg_card_clickable"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/item_processo_numero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Badge"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/item_processo_titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Section"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/item_processo_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Badge"
        android:background="@drawable/bg_green"
        android:textColor="@color/success"
        android:layout_marginBottom="14dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <TextView
        android:id="@+id/item_processo_advogado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Body"
        android:paddingTop="12dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ver detalhes"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:drawableEnd="@drawable/ic_chevron" />
</LinearLayout>
